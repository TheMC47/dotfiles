cabal-version: 2.4
name:          xmonad-private
version:       0.0.0
build-type:    Simple

-- Single executable on purpose: `xmonad --recompile` runs `cabal build` and
-- then copies whatever `cabal list-bin .` reports.
executable xmonad-private
  main-is:          xmonad.hs
  ghc-options:      -Wall
  default-language: Haskell2010
  build-depends:
      base >=4.7 && <5
    , X11
    , aeson
    , containers
    , directory
    , flow
    , process
    , split
    , time
    , unix
    , utf8-string
    , xmonad
    , xmonad-contrib
